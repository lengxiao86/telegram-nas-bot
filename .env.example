# From Telegram @BotFather
TELEGRAM_BOT_TOKEN=

# Required only for large videos: create these at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Absolute path of the existing NAS shared folder to save videos in.
NAS_VIDEO_DIR=/vol1/1000/TelegramVideos

# Comma-separated Telegram numeric user IDs. Strongly recommended.
# Leave blank to allow anyone who can message the bot to upload.
ALLOWED_TELEGRAM_USER_IDS=

# Seconds to wait while Telegram's Local Bot API fetches a large video.
TELEGRAM_REQUEST_READ_TIMEOUT=900

# Optional folder inside the mounted NAS share. Leave empty to save directly
# into NAS_VIDEO_DIR (the default).
SAVE_SUBDIR=

# How many video downloads can run at the same time. 2 is a safe default for
# large videos; raise it only if the NAS network and disk can handle it.
MAX_CONCURRENT_TRANSFERS=2

# Failed transfers retry automatically. A large file's first getFile may take
# time while Telegram transfers it to the Local Bot API Server.
DOWNLOAD_RETRIES=3
RETRY_DELAY_SECONDS=15

# Delete only old video files in the Local Bot API cache. Set retention to 0
# to disable automatic cleanup.
CACHE_RETENTION_HOURS=168
CACHE_CLEAN_INTERVAL_MINUTES=60
